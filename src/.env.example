# =============================================================================
# PortPulse AI — Consolidated Environment Variables Template
# Copy this file to .env or place corresponding .env files in frontend/ and backend/
# NEVER commit the actual .env files containing real secrets
# =============================================================================

# ── Backend Server (Node / Hono API) ──────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database (PostgreSQL / Supabase) ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your-db-password@db.your-supabase-host.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:your-db-password@db.your-supabase-host.supabase.co:5432/postgres

# ── Authentication & Security ────────────────────────────────────────────────
JWT_SECRET=your-secure-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=112305367877-uqesobtgqngibu38ekf4qu22pm4jicvb.apps.googleusercontent.com

# ── AI & Copilot Integration ─────────────────────────────────────────────────
# Supports IBM Bob / watsonx / Gemini
WATSONX_API_KEY=your-watsonx-api-key-here
WATSONX_PROJECT_ID=your-watsonx-project-id-here
GEMINI_API_KEY=your-gemini-api-key-here

# ── CORS & Client Networking ─────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# ── Frontend Specific (Vite Client) ──────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GOOGLE_CLIENT_ID=112305367877-uqesobtgqngibu38ekf4qu22pm4jicvb.apps.googleusercontent.com
